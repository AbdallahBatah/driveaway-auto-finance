run = "npm start"
entrypoint = "server/index.js"
modules = ["nodejs-22"]

[nix]
channel = "stable-24_05"

[env]
NODE_ENV = "production"

[deployment]
run = ["sh", "-c", "npm start"]
deploymentTarget = "cloudrun"
build = ["sh", "-c", "npm install --omit=dev"]

[[ports]]
localPort = 3000
externalPort = 80
